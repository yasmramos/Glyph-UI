// Glyph-UI declarative demo (.glyph).
//
// This file uses the Compose-style DSL, not HTML-like tags: every widget is a
// call with an optional argument list and a trailing block of children.
//
//   Column(id = "root", gap = 8) {      // a container with a vertical stack
//       Text("Hello")                   // a positional string is the label
//       Button("Go", onClick = run)     // named arguments are attributes
//   }
//
// Rules:
//   - A positional string or bare word becomes the widget's text content.
//   - A named argument becomes an attribute. camelCase is normalised
//     (fontSize -> font-size, onClick -> onclick); `flag = true` is a
//     valueless flag and `flag = false` is dropped.
//   - {path} is an interpolation captured as a raw binding node.
//   - Link a stylesheet with the Stylesheet("app.css") header (inline CSS is
//     not supported, because '{' opens a binding).
//
// The loader picks this front-end automatically: any document whose first
// significant character is not '<' is parsed as the DSL.

Stylesheet("app.css")

Column(id = "root", class = "page", gap = 12, padding = 24) {
    Text("Glyph-UI", class = "title")
    Text("Declarative DSL + CSS styling on a retained widget tree", class = "subtitle")

    Row(class = "card", gap = 8, padding = 16) {
        TextField(id = "name-field", class = "field", placeholder = "Your name")
        PasswordField(id = "password-field", class = "field", placeholder = "Password")
        Button("Greet", id = "greet-btn", class = "btn-primary", onClick = sayHello)
        Button("Dark mode", id = "dark-btn", class = "btn-secondary", onClick = toggleTheme)
    }

    TextArea(id = "notes", class = "field field-multiline", placeholder = "Notes…")

    Text(id = "status", class = "muted", "Ready.")
}
