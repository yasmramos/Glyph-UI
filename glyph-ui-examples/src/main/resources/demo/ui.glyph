<!--
  Glyph-UI declarative markup demo (.glyph).

  This is NOT a web page: there is no JavaScript engine and no DOM.
  UiLoader scans this fixed tag subset (div, button, label, p, input, img)
  into the native widget tree; everything else is styled through app.css
  (a documented subset of CSS selectors + custom properties).

  .glyph notes:
    - Tags are XML-like: <Tag attr="value">children</Tag> or <Tag/>.
    - {path} is an interpolation. It is captured by the parser as a raw
      binding node; reactive evaluation is not wired to UiLoader yet.
    - Inline <style> is NOT supported, because '{' is the interpolation
      delimiter. Link an external sheet with <link rel="stylesheet" .../>.
-->
<link rel="stylesheet" href="app.css"/>
<body>
    <div id="root" class="column gap-md" layout="flex" style="flex-direction: column;">
        <label class="title">Glyph-UI</label>
        <p class="subtitle">Declarative markup + CSS styling on a retained widget tree</p>

        <div class="card row gap-sm" layout="flex">
            <input id="name-field" class="field" placeholder="Your name"/>
            <button id="greet-btn" class="btn-primary" onclick="sayHello">Greet</button>
            <button id="dark-btn" class="btn-secondary" onclick="toggleTheme">Dark mode</button>
        </div>

        <div class="footer">
            <label id="status" class="muted">Ready.</label>
        </div>
    </div>
</body>
