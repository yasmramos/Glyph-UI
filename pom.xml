<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.yasmramos</groupId>
    <artifactId>glyph-ui</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Glyph UI</name>
    <description>A modern UI toolkit built on Skija and JWM</description>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skija.version>0.116.2</skija.version>
        <jwm.version>0.4.25</jwm.version>
        <jacoco.version>0.8.15</jacoco.version>
    </properties>

    <profiles>
        <!-- Windows profile -->
        <profile>
            <id>windows</id>
            <activation>
                <os>
                    <family>windows</family>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <skija.artifact>skija-windows-x64</skija.artifact>
            </properties>
        </profile>

        <!-- Linux profile -->
        <profile>
            <id>linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <skija.artifact>skija-linux-x64</skija.artifact>
            </properties>
        </profile>

        <!-- macOS Intel profile -->
        <profile>
            <id>macos-intel</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>x86_64</arch>
                </os>
            </activation>
            <properties>
                <skija.artifact>skija-macos-x64</skija.artifact>
            </properties>
        </profile>

        <!-- macOS ARM profile -->
        <profile>
            <id>macos-arm</id>
            <activation>
                <os>
                    <family>mac</family>
                    <arch>aarch64</arch>
                </os>
            </activation>
            <properties>
                <skija.artifact>skija-macos-arm64</skija.artifact>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- JWM: primary native-window backend (IME, clipboard, DPI). -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>jwm</artifactId>
            <version>${jwm.version}</version>
        </dependency>

        <!-- Skija -->
        <dependency>
            <groupId>io.github.humbleui</groupId>
            <artifactId>${skija.artifact}</artifactId>
            <version>${skija.version}</version>
        </dependency>

        <!-- ph-css: CSS parser used by the style subsystem -->
        <dependency>
            <groupId>com.helger</groupId>
            <artifactId>ph-css</artifactId>
            <version>6.2.3</version>
        </dependency>

        <!-- JUnit 5 for testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                </configuration>
            </plugin>
            <!--
                The runnable demo entry point (DemoButtons) now lives in the
                separate glyph-ui-examples module, so this library jar has no
                main class. Run the examples from that module instead:
                  cd glyph-ui-examples && mvn exec:java
            -->
            <!-- Maven Surefire Plugin for JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.1.2</version>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                </configuration>
            </plugin>
            <!-- JaCoCo code coverage -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <!-- Attach the JaCoCo agent before tests run -->
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <!-- ph-css ships generated javacc lexers (e.g.
                                 ParserCSS30TokenManager) whose methods exceed
                                 the JVM 64KB bytecode limit; instrumenting them
                                 makes JaCoCo throw MethodTooLargeException and
                                 abort the test run. Third-party code carries no
                                 coverage requirement, so exclude it. -->
                            <excludes>
                                <exclude>com/helger/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <!-- Generate HTML/XML coverage report after tests -->
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- Enforce minimum coverage thresholds during verify -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Real coverage: ~47.9% lines; raise as tests grow -->
                                            <minimum>0.45</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <!-- Real coverage: ~38.6% branches; raise as tests grow -->
                                            <minimum>0.35</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
